{
  "name": "punto-venta-web",
  "version": "0.0.0",
  "scripts": {
    "check:runtime": "node ./scripts/check-runtime.mjs",
    "prestart": "npm run check:runtime",
    "prebuild": "npm run check:runtime",
    "prewatch": "npm run check:runtime",
    "pretest": "npm run check:runtime",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:punto-venta-web": "node dist/punto-venta-web/server/server.mjs"
